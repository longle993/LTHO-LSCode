<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LSCode</AssemblyName>
    <Product>LTHO Studio Code</Product>
    <Description>LS Code — ERP developer workspace</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.117.0" />
    <ProjectReference Include="..\LSCode.Core\LSCode.Core.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\snippets.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\jssnippet.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\sqlsnippet.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Template\SQL2014.tdf" Link="Template\SQL2014.tdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Template\SQL2014.WithDatabase.tdf" Link="Template\SQL2014.WithDatabase.tdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\LSCode.TraceHost\bin\LSCode.TraceHost.exe" Link="LSCode.TraceHost.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildTraceHost" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\LSCode.TraceHost\bin" />
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\csc.exe&quot; /nologo /target:exe /platform:x86 /reference:System.Data.dll /reference:System.Web.Extensions.dll /out:&quot;$(MSBuildProjectDirectory)\..\LSCode.TraceHost\bin\LSCode.TraceHost.exe&quot; &quot;$(MSBuildProjectDirectory)\..\LSCode.TraceHost\Program.cs&quot; &quot;$(MSBuildProjectDirectory)\..\LSCode.Core\ProfilerDatabaseFilter.cs&quot;" />
  </Target>
</Project>
