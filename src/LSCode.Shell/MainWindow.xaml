<Window x:Class="LSCode.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LS Code — LTHO Studio Code" FontFamily="Segoe UI" FontSize="13" Width="1420" Height="900" MinWidth="980" MinHeight="640" WindowStartupLocation="Manual" WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True"><WindowChrome.WindowChrome><WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
<Grid x:Name="WindowLayers"><DockPanel x:Name="MainDock">
<Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource Panel}" Padding="16,8" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Accent}" CornerRadius="4" Padding="6"><TextBlock Text="LS" Foreground="{DynamicResource OnAccent}" FontWeight="Bold"/></Border><TextBlock Text="  STUDIO CODE" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" WindowChrome.IsHitTestVisibleInChrome="True" Content="Tìm lệnh…   Ctrl+Shift+P" MaxWidth="330" HorizontalAlignment="Stretch" Foreground="{DynamicResource Muted}" Click="Palette_Click"/><StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Style="{StaticResource IconButton}" ToolTip="Thu nhỏ" Click="MinimizeWindow_Click"/><Button x:Name="MaximizeWindowButton" Content="□" Style="{StaticResource IconButton}" ToolTip="Phóng to" Click="MaximizeWindow_Click"/><Button Content="×" Style="{StaticResource IconButton}" ToolTip="Đóng" Click="CloseWindow_Click"/></StackPanel></Grid></Border>
    <Menu DockPanel.Dock="Top" Padding="6,3">
      <MenuItem Style="{StaticResource RootMenuItem}" Header="File"><MenuItem Header="New file" Click="New_Click"/><MenuItem Header="Open file" Click="Open_Click"/><MenuItem Header="Open folder" Click="OpenFolder_Click"/><Separator/><MenuItem Header="Save" Click="Save_Click"/><MenuItem Header="Save as" Click="SaveAs_Click"/><MenuItem Header="Close tab" Click="Close_Click"/></MenuItem>
      <MenuItem Header="Editor"><MenuItem Header="Find" Click="Find_Click"/><MenuItem Header="Replace" Click="Replace_Click"/><MenuItem Header="Format SQL / XML / JSON" Click="Format_Click"/><MenuItem Header="Evaluate XPath…" Click="XPath_Click"/><MenuItem Header="Split editor" Click="Split_Click"/><MenuItem Header="Compare with file…" Click="Compare_Click"/></MenuItem>
      <MenuItem Style="{StaticResource RootMenuItem}" Header="SQL"><MenuItem Header="New SQL" Click="New_Click"/><MenuItem Header="Cấu trúc và dữ liệu" Click="TableBrowser_Click"/><MenuItem Header="Tạo danh mục…" Click="Catalog_Click"/><Separator/><MenuItem Header="Connection…" Click="Connection_Click"/><MenuItem Header="Execute selection / document" Click="Execute_Click"/><MenuItem Header="Cancel query" Click="Cancel_Click"/><MenuItem Header="Export selected result as CSV…" Click="Export_Click"/></MenuItem>
      <MenuItem Style="{StaticResource RootMenuItem}" Header="Tools"><MenuItem Header="Compare Text…" Click="CompareText_Click"/><MenuItem Header="Compare Folder…" Click="CompareFolder_Click"/><MenuItem Header="Beautify SQL…" Click="BeautifySql_Click"/><Separator/><MenuItem Header="Đổi theme" Click="Theme_Click"/><MenuItem Header="Snippets" Click="SnippetPanel_Click"/><MenuItem Header="Google Dịch" Click="Translate_Click"/><MenuItem Header="Open Crystal report…" Click="Crystal_Click"/><MenuItem Header="LS Code Profiler — SSMS 18" Click="Profiler18_Click"/><MenuItem Header="External tools settings…" Click="ToolsSettings_Click"/></MenuItem>
      <MenuItem Style="{StaticResource RootMenuItem}" Header="Project"><MenuItem Header="Đồng bộ dự án…" Click="SyncProject_Click"/><Separator/><MenuItem Header="Chọn project…" Click="SelectProject_Click"/><MenuItem Header="Tạo project profile…" Click="CreateProject_Click"/><MenuItem Header="Import legacy XML…" Click="ImportProject_Click"/><MenuItem Header="Xem metadata project" Click="ProjectDetails_Click"/><MenuItem Header="Export project catalog…" Click="ExportProjects_Click"/></MenuItem><MenuItem Style="{StaticResource RootMenuItem}" Header="Workspace"><MenuItem Header="File dự án" Click="ExplorerPanel_Click"/><MenuItem Header="Chức năng dự án / DB Object" Click="ProjectPanel_Click"/><MenuItem Header="Search" Click="SearchPanel_Click"/><MenuItem Header="Refresh explorer" Click="Refresh_Click"/><MenuItem Header="Import legacy project configuration…" Click="ImportProject_Click"/></MenuItem><MenuItem Style="{StaticResource RootMenuItem}" x:Name="ShortcutMenu" Header="Phím tắt"/>
    </Menu>

<Border x:Name="ProjectContextBar" Visibility="Collapsed" DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="8,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Visibility="Collapsed" Text="{Binding Text, ElementName=WorkspaceName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" x:Name="LoadingStrip" Visibility="Collapsed" Width="180" Margin="12,0"><TextBlock x:Name="LoadingMessage" Text="Đang tải…" FontSize="12" TextTrimming="CharacterEllipsis"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Raised}"/></StackPanel><Button Grid.Column="2" Content="Đổi dự án…" MinHeight="24" FontSize="12" Padding="6,2" Margin="0" Style="{StaticResource GhostButton}" Click="SelectProject_Click"/></Grid></Border>
<Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="LS Code · Sẵn sàng" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" x:Name="CaretStatus" Text="UTF-8 · Plain text" FontSize="12" Foreground="{DynamicResource Muted}"/></Grid></Border>
<Grid x:Name="WorkspaceGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition x:Name="NavigationColumn" Width="264" MinWidth="220" MaxWidth="420"/><ColumnDefinition x:Name="NavigationSplitterColumn" Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel><Button DockPanel.Dock="Bottom" Content="⚙" Style="{StaticResource IconButton}" ToolTip="Thêm / bỏ lối tắt" Click="CustomizeActivity_Click"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ActivityButtons" Margin="4,8"/></ScrollViewer></DockPanel></Border>
<DockPanel x:Name="NavigationPane" Grid.Column="1" Background="{DynamicResource Panel}"><DockPanel.Resources>
<Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="5,2"/></Style>
<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,3"/></Style>
<Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,3"/></Style>
</DockPanel.Resources><Grid DockPanel.Dock="Top" Margin="8,3,6,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="KHÔNG GIAN DỰ ÁN" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="‹" Width="24" Height="24" MinHeight="24" Padding="0" Margin="0" Style="{StaticResource IconButton}" ToolTip="Thu gọn điều hướng" Click="ToggleNavigation_Click"/></Grid><UniformGrid DockPanel.Dock="Top" Columns="3" Margin="5,0,5,3"><Button x:Name="FilesNavigation" Content="File" Style="{StaticResource NavigationButton}" Click="FilesNavigation_Click"/><Button x:Name="FunctionsNavigation" Content="Chức năng" Style="{StaticResource NavigationButton}" Click="FunctionsNavigation_Click"/><Button x:Name="DatabaseNavigation" Content="DB" Style="{StaticResource NavigationButton}" Click="DatabaseNavigation_Click"/></UniformGrid><Grid x:Name="NavigationContent"><DockPanel x:Name="ProjectPanel" Visibility="Collapsed" Background="{DynamicResource Panel}"><TabControl x:Name="ProjectViews" Style="{StaticResource HeaderlessTabs}" SelectionChanged="ProjectViews_SelectionChanged"><TabItem Header="Chức năng dự án"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="6,3"><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,3"/></Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,3"/></Style></StackPanel.Resources>
    
    <WrapPanel Margin="0,0,0,2"><Button Content="Đồng bộ…" Click="SyncProject_Click"/><Button Content="Tải lại" Click="ReloadCommands_Click"/><Button Content="Dừng" Click="CancelSync_Click"/></WrapPanel>
    <TextBlock Text="Tên / sysid → Enter (tiếp tục để tìm kế)" FontSize="11" Margin="3,2" Foreground="{DynamicResource Muted}"/><TextBox x:Name="CommandSearch" ToolTip="Tìm tên chức năng, sysid hoặc mã menu" KeyDown="CommandSearch_KeyDown"/><TextBlock x:Name="CommandStatus" Text="Đồng bộ dự án để tải cây chức năng." TextWrapping="Wrap" Margin="3,6" Foreground="{DynamicResource Muted}"/>
  </StackPanel>
  <TreeView x:Name="CommandTree" Margin="5" PreviewMouseLeftButtonDown="CommandTree_DoubleClick"/></DockPanel></TabItem><TabItem x:Name="DbObjectTab" Header="DB Object"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="↻" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" ToolTip="Tải lại DB Object" Click="RefreshDbObjects_Click"/><ComboBox x:Name="DbSearchMode" SelectedIndex="0" SelectionChanged="DbSearchMode_Changed"><ComboBoxItem Content="Tìm theo tên"/><ComboBoxItem Content="Nội dung procedure/function"/></ComboBox><TextBox x:Name="DbObjectSearch" MaxLength="1000" ToolTip="Tên đối tượng hoặc nội dung SQL; Enter để tìm nội dung" TextChanged="DbObjectSearch_Changed" KeyDown="DbObjectSearch_KeyDown"/><TextBlock x:Name="DbObjectStatus" Text="Chọn tab để tải App DB." TextWrapping="Wrap" Margin="6"/></StackPanel><TreeView x:Name="DbObjects"/></DockPanel></TabItem></TabControl></DockPanel><Grid x:Name="SidePanelContent"  Background="{DynamicResource Panel}">
        <DockPanel x:Name="ExplorerPanel"><Button DockPanel.Dock="Bottom" Content="▤  SQL Profiler" HorizontalContentAlignment="Left" MinHeight="28" Padding="6,3" Margin="4,3,4,3" ToolTip="Mở Profiler trong vùng soạn thảo" Click="Profiler18_Click"/><StackPanel DockPanel.Dock="Top" Margin="7,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="FILE DỰ ÁN" FontSize="11" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="📂" Width="24" Height="22" Padding="0" ToolTip="Mở Windows Explorer" Click="OpenWorkspaceExplorer_Click"/></Grid><TextBlock x:Name="WorkspaceName" Text="Chưa mở workspace" Margin="0,1,0,0" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="ProjectWebAddress" Visibility="Collapsed" Margin="0,4,0,2" FontSize="11" TextTrimming="CharacterEllipsis"><Hyperlink x:Name="ProjectWebLink" Foreground="{DynamicResource Accent}" Click="ProjectWebLink_Click"><Run x:Name="ProjectWebLabel"/></Hyperlink></TextBlock></StackPanel><DockPanel><Border DockPanel.Dock="Top" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Accent}" BorderThickness="2,0,0,0" Padding="5,2" Margin="3,2" MinHeight="30"><DockPanel><TextBlock Text="◆" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/><Button Content="▾" Width="22" Height="22" Padding="0" DockPanel.Dock="Right" ToolTip="Tất cả cửa sổ đang mở" Click="AllControllers_Click"/><Button x:Name="ClosePinnedController" Content="×" Width="22" Height="22" Padding="0" DockPanel.Dock="Right" Click="ClosePinnedController_Click"/><TextBlock x:Name="PinnedController" FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="Toàn dự án" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Border><UniformGrid x:Name="RecentControllers" Rows="1" DockPanel.Dock="Top" MinHeight="28"/><TabControl x:Name="ProjectFileTabs" HorizontalContentAlignment="Left" SelectionChanged="ProjectFileTabs_SelectionChanged"><TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></TabControl.ItemsPanel><TabControl.Template><ControlTemplate TargetType="TabControl"><DockPanel><ItemsPresenter Visibility="Collapsed" DockPanel.Dock="Top"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></DockPanel></ControlTemplate></TabControl.Template><TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="HeaderBorder" Padding="4,2" Margin="3,1" BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Raised}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderBorder" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources><TabItem Header="Toàn dự án"><TreeView x:Name="Explorer" MouseDoubleClick="Explorer_DoubleClick" Margin="6"/></TabItem></TabControl></DockPanel></DockPanel>
        <DockPanel x:Name="SearchPanel" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top" Margin="12,12"><TextBlock Text="SEARCH WORKSPACE" Foreground="{DynamicResource Muted}"/><TextBox x:Name="SearchInput" Margin="0,14,0,4" KeyDown="SearchInput_KeyDown"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="RegexSearch" Content="Regex"/><CheckBox x:Name="CaseSearch" Content="Aa"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="Tìm" Click="Search_Click"/><Button Content="Dừng" Click="SearchCancel_Click"/></StackPanel><TextBlock x:Name="SearchSummary" Text="Tìm trong các file đã lưu" TextWrapping="Wrap" Margin="3,8" Foreground="{DynamicResource Muted}"/></StackPanel><ListBox x:Name="SearchResults" MouseDoubleClick="SearchResult_DoubleClick"/></DockPanel>
        <DockPanel x:Name="SnippetPanel" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top" Margin="10,15"><TextBlock Text="SNIPPETS" Foreground="{DynamicResource Muted}"/><TextBox x:Name="SnippetFilter" TextChanged="SnippetFilter_Changed" Margin="0,14,0,4"/><WrapPanel><Button Content="Chèn" Click="InsertSnippet_Click"/><Button Content="Mới" Click="NewSnippet_Click"/><Button Content="Sửa" Click="EditSnippet_Click"/><Button Content="Xóa" Click="DeleteSnippet_Click"/><Button Content="Import" Click="ImportSnippets_Click"/><Button Content="Export" Click="ExportSnippets_Click"/></WrapPanel></StackPanel><ListBox x:Name="SnippetList" MouseDoubleClick="Snippet_DoubleClick"/></DockPanel>
      </Grid></Grid></DockPanel>
<Button x:Name="ProjectRestore" Grid.Column="1" Content="›" Visibility="Collapsed" VerticalAlignment="Top" Width="26" Height="32" Padding="0" Margin="0" ToolTip="Mở điều hướng" Click="ToggleProjectPanel_Click"/><Button x:Name="ExplorerRestore" Grid.Column="1" Content="›" Visibility="Collapsed" VerticalAlignment="Top" Width="26" Height="32" Padding="0" Margin="0" ToolTip="Mở điều hướng" Click="ToggleExplorerPanel_Click"/>
<GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Panel}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="BottomSplitterRow" Height="6"/><RowDefinition x:Name="BottomRow" Height="230" MinHeight="120"/></Grid.RowDefinitions>
        <Grid><TabControl x:Name="Documents" SelectionChanged="Documents_SelectionChanged"/>
          <Border x:Name="Welcome" Background="{DynamicResource Surface}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Margin="32"><TextBlock Text="LTHO Studio Code" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="File, chức năng ERP và SQL trong cùng một không gian." Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,24"/><Button Content="Mở thư mục dự án" Click="OpenFolder_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/><Button Content="Mở file SQL, XML hoặc văn bản    Ctrl+O" Click="Open_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/><Button Content="Tạo truy vấn SQL mới    Ctrl+Shift+Q" Click="New_Click" HorizontalAlignment="Left" Margin="0,0,0,24"/><TextBlock Text="Ctrl+P  Tìm file     Ctrl+Shift+P  Tìm lệnh" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
        <GridSplitter x:Name="BottomSplitter" ShowsPreview="True" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Panel}" Cursor="SizeNS"/>
<Grid Grid.Row="2"><TabControl x:Name="BottomPanel">
          <TabItem Header="Thông báo"><TextBox x:Name="Output" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
          <TabItem Header="Problems"><ListBox x:Name="Problems" MouseDoubleClick="Problem_DoubleClick"/></TabItem>
          <TabItem Header="Kết quả SQL"><TabControl x:Name="Results"/></TabItem>
          <TabItem Header="XML Outline"><TreeView x:Name="Outline" MouseDoubleClick="Outline_DoubleClick"/></TabItem>
        </TabControl><Button x:Name="BottomToggle" Style="{StaticResource IconButton}" ToolTip="Ẩn kết quả" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4,0" Click="BottomToggle_Click"><TextBlock x:Name="BottomToggleIcon" Text="⌄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></Grid>
      </Grid>
</Grid></DockPanel></Grid></Window>